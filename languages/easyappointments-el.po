msgid "Easy!Appointments"
msgstr "Easy!Appointments"

#: includes/class-easyappointments-elementor-widget.php:43
msgid "Booking Page"
msgstr "Σελίδα κρατήσεων"

#: includes/class-easyappointments-elementor-widget.php:51
msgid "Width"
msgstr "Πλάτος"

#: includes/class-easyappointments-elementor-widget.php:55
